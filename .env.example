# Copy to .env and fill in. Never commit the real .env file.

# Order of LLM providers: the first one that works answers, the others are fallbacks.
# Keep "mock" at the end only for demos. For production use: LLM_PROVIDERS=anthropic,openai
LLM_PROVIDERS=anthropic,openai,mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Small model for side jobs (query rewriting, translating booking messages)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# Where the knowledge base is searched: bm25 (in memory, default) or qdrant (vector database).
RETRIEVER=bm25
# For RETRIEVER=qdrant: a server or Qdrant Cloud URL, or a folder for embedded mode, or neither (in memory).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COLLECTION=knowledge

# Optional: every new lead and appointment is also POSTed here (n8n webhook, Make, Zapier, your CRM API).
CRM_WEBHOOK_URL=
# Optional: sent in the X-Webhook-Secret header so that n8n can refuse requests from anyone else.
CRM_WEBHOOK_SECRET=

# Optional: HubSpot (free CRM). A private-app access token turns every lead into a HubSpot contact.
# Scopes: crm.objects.contacts.read and crm.objects.contacts.write (and crm.schemas.contacts.read/write once, to create
# the custom properties with: python -m scripts.check_integrations --create-properties).
HUBSPOT_TOKEN=

# Optional: Google Calendar. The calendar id (usually an e-mail address) of a calendar that is shared with the service
# account, and the path of the service account's JSON key. With both set, busy times are not offered and every booking
# also becomes an event in that calendar. TIMEZONE is the time zone of OPEN_HOUR/CLOSE_HOUR.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
TIMEZONE=Europe/Bratislava

# Optional: enables /admin/leads and /admin/reindex (send the token in the X-Admin-Token header).
ADMIN_TOKEN=

# Optional: allow the widget to be embedded on another website (comma separated origins).
ALLOWED_ORIGINS=

# Set to 0 to search with the visitor's original message only (saves one small model call)
QUERY_REWRITE=1

# Services that can be booked (the model must use exactly these names)
SERVICES=Check-up,Cleaning,Teeth whitening,Filling,Orthodontic consultation

# Booking rules
OPEN_HOUR=9
CLOSE_HOUR=17
SLOT_MINUTES=30
BUSINESS_NAME=Bright Smile Dental

# Meaning-based search on top of BM25 (needs RETRIEVER=qdrant): fastembed (local, pip install fastembed) or openai.
EMBEDDER=
EMBEDDING_MODEL=
# Minimum cosine score for a meaning match. Tune with scripts/eval_retrieval.py.
DENSE_MIN_SCORE=0.6

# Protection of a public chat (0 turns a limit off). TRUST_PROXY=1 only behind a reverse proxy (docker-compose sets it).
RATE_LIMIT_IP=40
DAILY_MESSAGE_CAP=1000
TRUST_PROXY=0

# How far ahead a visit can be booked, in days.
MAX_BOOKING_DAYS=180

# Optional: a Telegram channel (create the bot with @BotFather, never share the token). Start it with
#   docker compose --profile telegram up -d
TELEGRAM_BOT_TOKEN=

# Optional: a WhatsApp channel (Meta WhatsApp Cloud API). In the Meta app: the webhook address is
# https://<your domain>/whatsapp/webhook and the verify token is the text you choose below. The channel is on
# when the first three are set. WHATSAPP_APP_SECRET (App settings, Basic) makes the webhook refuse unsigned calls.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Optional: a WhatsApp channel through Twilio (the WhatsApp sandbox works with a free trial account). In the Twilio
# console (Messaging > Try it out > Send a WhatsApp message > Sandbox settings) set "When a message comes in" to
# TWILIO_WEBHOOK_URL, method POST. The channel is on when the first three are set. TWILIO_WEBHOOK_URL must be the
# same address, character for character: the signature check is calculated over it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=https://<your domain>/twilio/whatsapp
# The sandbox number; replace it with your own registered WhatsApp sender in production.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
